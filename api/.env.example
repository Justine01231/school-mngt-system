# ===================================
# API — Environment Variables Example
# Copy this file to .env and fill in values before running.
# NEVER commit the real .env file!
# ===================================

# Server
NODE_ENV=development
PORT=3000

# Database — PostgreSQL connection string
# Local dev: postgresql://<user>:<password>@localhost:5433/<dbname>
# Docker:    postgresql://<user>:<password>@postgres:5432/<dbname>
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5433/school_sys"

# JWT — generate strong random secrets (min 32 chars)
# Use: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_32_CHARS"

# Token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Security
BCRYPT_ROUNDS=12

# CORS — comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173"

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
